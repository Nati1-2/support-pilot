# ==============================================================================
# SupportPilot AI v2.0 — Environment Configuration Template
# ==============================================================================

# --- Google Gemini AI Engine ---
# Get an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- MongoDB Database ---
# MongoDB Atlas connection string (or leave blank to use the built-in local store)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/
MONGODB_DB_NAME=supportpilot

# --- Authentication & JWT Security ---
JWT_SECRET=supportpilot_production_jwt_secret_key_v2_2026_vercel
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Deterministic Safety Limits & Guardrails ---
CONFIDENCE_THRESHOLD=0.90
DUMMYJSON_ENABLED=true
WEBHOOK_SECRET=supportpilot_webhook_secret_v2_2026
CRON_SECRET=supportpilot_cron_secret_v2_2026
STORE_CREDIT_MAX_CAP=50.0
VIP_SPENT_THRESHOLD=200.0
DEFAULT_WORKSPACE_ID=ws_aerowear_prod

# --- Environment ---
ENVIRONMENT=production
PROJECT_NAME="SupportPilot AI"
