# Copy this one file to `.env` for local development. For Vercel, import the
# same key/value pairs in Project Settings > Environment Variables.

# Required on Vercel. The local fallback database is ephemeral in a serverless
# function, so use MongoDB Atlas for durable production data.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/supportpilot
MONGODB_DB_NAME=supportpilot

# Required secrets. Generate a different random value for each one, for example:
# openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_VALUE
WEBHOOK_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_64_CHARACTER_VALUE
CRON_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_64_CHARACTER_VALUE

# Optional: without a key, the deterministic simulation engine remains active.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Application defaults shared by the frontend and backend deployment.
DUMMYJSON_ENABLED=true
CONFIDENCE_THRESHOLD=0.90
STORE_CREDIT_MAX_CAP=50.0
VIP_SPENT_THRESHOLD=200.0
DEFAULT_WORKSPACE_ID=ws_aerowear_prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256
ENVIRONMENT=production
PROJECT_NAME="SupportPilot AI"
